# 运行环境: dev（开发，自动关闭鉴权）| prod（生产，开启鉴权）
ENV=dev

# DeepSeek API 配置
# 去 https://platform.deepseek.com/ 注册获取 API Key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型 API 标识（是接口 id，不是产品显示名）:
#   deepseek-flash   → DeepSeek-V4.1-Flash
#   deepseek-v4-pro  → DeepSeek-V4-Pro
LLM_MODEL=deepseek-flash

# ── Embedding（默认走 SiliconFlow API，免费）────────────────
# BAAI/bge-m3：0 元/K tokens，输出 1024 维，单条文本上限 8192 tokens
# 模型 id 必须写全 "BAAI/bge-m3"，写成 "bge-m3" 会返回 400 Model does not exist
# 去 https://cloud.siliconflow.cn/ 注册获取 API Key
# 注意：免费模型仍需账户完成实名认证且余额非负，否则返回 402 (code 30001)
EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Embedding 提供者: api（默认，走 SiliconFlow）| local（只用本地模型，不发网络请求）
EMBEDDING_PROVIDER=api

# API 临时不可用时的本地兜底模型（可选；填本地路径或 HuggingFace 模型名）
# 本地路径示例: D:/model/bge-base-zh-v1.5
# HF 模型示例:  sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_MODEL=D:/model/bge-base-zh-v1.5

# ── Gateway（FastAPI :8000）──────────────────────────────
# prod 环境下 Gateway 校验 Bearer Token；dev 环境自动放行
GATEWAY_API_KEY=dev-key-change-me
# 限流：每分钟请求数
GATEWAY_RATE_LIMIT=60

# ── 日志级别: DEBUG | INFO | WARNING | ERROR ──
LOG_LEVEL=INFO
